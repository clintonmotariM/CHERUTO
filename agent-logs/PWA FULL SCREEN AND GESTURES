### Complete App Integration

```jsx
// App.jsx
import { BrowserRouter, useLocation } from 'react-router-dom';
import { useState, useEffect } from 'react';

// ==================== STANDALONE DETECTION ====================

function isStandaloneMode() {
  return (
    window.matchMedia('(display-mode: standalone)').matches ||
    window.matchMedia('(display-mode: fullscreen)').matches ||
    window.matchMedia('(display-mode: minimal-ui)').matches ||
    window.navigator.standalone === true ||
    document.referrer.includes('android-app://')
  );
}

// ==================== SWIPE BACK HOOK ====================

function useSwipeBack({ disabled = false, threshold = 50, maxVertical = 80 } = {}) {
  const navigate = useNavigate();
  const startX = useRef(0);
  const startY = useRef(0);

  useEffect(() => {
    if (disabled) return;

    const onTouchStart = (e) => {
      startX.current = e.changedTouches[0].screenX;
      startY.current = e.changedTouches[0].screenY;
    };

    const onTouchEnd = (e) => {
      const dx = startX.current - e.changedTouches[0].screenX;
      const dy = Math.abs(startY.current - e.changedTouches[0].screenY);

      if (dy >= maxVertical) return;
      if (dx >= -threshold) return;
      if (window.history.length <= 1) return;

      navigate(-1);
    };

    document.addEventListener('touchstart', onTouchStart, { passive: true });
    document.addEventListener('touchend', onTouchEnd, { passive: true });

    return () => {
      document.removeEventListener('touchstart', onTouchStart);
      document.removeEventListener('touchend', onTouchEnd);
    };
  }, [disabled, threshold, maxVertical, navigate]);
}

// ==================== FULLSCREEN PROMPT ====================

function FullscreenPrompt({ onDismiss }) {
  const [isVisible, setIsVisible] = useState(false);

  useEffect(() => {
    if (isStandaloneMode()) {
      onDismiss?.();
      return;
    }

    const preferFullscreen = localStorage.getItem('prefer-fullscreen');
    
    if (preferFullscreen === 'true') {
      enterFullscreen();
    } else if (!preferFullscreen) {
      setTimeout(() => setIsVisible(true), 300);
    } else {
      onDismiss?.();
    }
  }, []);

  const enterFullscreen = async () => {
    try {
      const doc = document.documentElement;
      if (doc.requestFullscreen) await doc.requestFullscreen();
      else if (doc.webkitRequestFullscreen) await doc.webkitRequestFullscreen();
      else if (doc.msRequestFullscreen) await doc.msRequestFullscreen();
      
      localStorage.setItem('prefer-fullscreen', 'true');
      setIsVisible(false);
      onDismiss?.();
    } catch (err) {
      console.error('Fullscreen failed:', err);
    }
  };

  const continueNormal = () => {
    localStorage.setItem('prefer-fullscreen', 'false');
    setIsVisible(false);
    onDismiss?.();
  };

  if (!isVisible) return null;

  return (
    <div style={{
      position: 'fixed', inset: 0, zIndex: 999999,
      background: 'rgba(0,0,0,0.9)',
      display: 'flex', alignItems: 'center', justifyContent: 'center'
    }}>
      <div style={{ textAlign: 'center', color: 'white' }}>
        <h2>Go Fullscreen?</h2>
        <button onClick={enterFullscreen}>Enter Fullscreen</button>
        <button onClick={continueNormal}>Continue in Browser</button>
      </div>
    </div>
  );
}

// ==================== MAIN APP ====================

const SWIPE_DISABLED_PATHS = new Set(['/login', '/home', '/dashboard']);

function App() {
  const [showPrompt, setShowPrompt] = useState(true);
  const { pathname } = useLocation();

  useSwipeBack({ disabled: SWIPE_DISABLED_PATHS.has(pathname) });

  return (
    <>
      {showPrompt && <FullscreenPrompt onDismiss={() => setShowPrompt(false)} />}
      <Routes>{/* Your routes */}</Routes>
    </>
  );
}
