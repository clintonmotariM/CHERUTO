## Fullscreen Implementation

### Multi-Browser Detection

Different browsers use different APIs to detect PWA standalone mode:

```javascript
function isStandaloneMode() {
  const checks = {
    // Chromium browsers (Chrome, Edge, Opera, Samsung, Brave)
    displayStandalone: window.matchMedia('(display-mode: standalone)').matches,
    displayFullscreen: window.matchMedia('(display-mode: fullscreen)').matches,
    displayMinimalUi: window.matchMedia('(display-mode: minimal-ui)').matches,
    
    // iOS Safari (iPhone/iPad)
    iosStandalone: window.navigator.standalone === true,
    
    // Android Trusted Web Activity / WebView
    androidTwa: document.referrer.includes('android-app://'),
  };
  
  const isStandalone = Object.values(checks).some(Boolean);
  
  // Debug logging
  console.log('[PWA] Standalone detection:', checks, { result: isStandalone });
  
  return isStandalone;
}
```

### React Hook: useStandaloneDetection

```javascript
import { useState, useEffect } from 'react';

export function useStandaloneDetection() {
  const [isStandalone, setIsStandalone] = useState(() => {
    if (typeof window === 'undefined') return false;
    return isStandaloneMode();
  });

  useEffect(() => {
    // Check immediately and after delays (some browsers report late)
    const check = () => setIsStandalone(isStandaloneMode());
    
    check();
    const t1 = setTimeout(check, 500);
    const t2 = setTimeout(check, 1500);
    
    // Listen for display mode changes
    const mql = window.matchMedia('(display-mode: standalone)');
    const handler = (e) => setIsStandalone(e.matches || isStandaloneMode());
    
    mql.addEventListener('change', handler);
    
    return () => {
      clearTimeout(t1);
      clearTimeout(t2);
      mql.removeEventListener('change', handler);
    };
  }, []);

  return isStandalone;
}
```

### Fullscreen Prompt Component

Shows a modal offering fullscreen mode on first visit:

```jsx
function FullscreenPrompt({ onDismiss }) {
  const [isVisible, setIsVisible] = useState(false);
  const isStandalone = useStandaloneDetection();

  useEffect(() => {
    // Don't show if already in PWA mode
    if (isStandalone) {
      onDismiss?.();
      return;
    }
    
    // Check previous preference
    const preferFullscreen = localStorage.getItem('prefer-fullscreen');
    
    if (preferFullscreen === 'true') {
      enterFullscreen();
    } else if (preferFullscreen === 'false') {
      onDismiss?.();
    } else {
      // First visit - show prompt after delay
      setTimeout(() => setIsVisible(true), 300);
    }
  }, [isStandalone]);

  const enterFullscreen = async () => {
    try {
      const doc = document.documentElement;
      
      if (doc.requestFullscreen) {
        await doc.requestFullscreen();
      } else if (doc.webkitRequestFullscreen) {
        await doc.webkitRequestFullscreen();
      } else if (doc.msRequestFullscreen) {
        await doc.msRequestFullscreen();
      }
      
      localStorage.setItem('prefer-fullscreen', 'true');
      setIsVisible(false);
      onDismiss?.();
    } catch (err) {
      console.error('Fullscreen failed:', err);
      alert('Fullscreen not supported. Try "Add to Home Screen" instead.');
    }
  };

  const continueNormal = () => {
    localStorage.setItem('prefer-fullscreen', 'false');
    setIsVisible(false);
    onDismiss?.();
  };

  if (!isVisible || isStandalone) return null;

  return (
    <div style={styles.overlay}>
      <div style={styles.modal}>
        <h2>Go Fullscreen?</h2>
        <p>Enter fullscreen for the best app experience</p>
        <button onClick={enterFullscreen} style={styles.primary}>
          Enter Fullscreen
        </button>
        <button onClick={continueNormal} style={styles.secondary}>
          Continue in Browser
        </button>
      </div>
    </div>
  );
}
```

